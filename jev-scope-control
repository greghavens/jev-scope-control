def compose(values: dict[str, float]) -> dict[str, float]:
    """Each denying component's decision score. The ANDs are mins."""
    # A call that changes nothing is never out of scope, so every component is capped by makes_change.
    change = values.get("makes_change", 1.0)
    scores = {name: min(values[name], change) for name in DIRECT if name in values}
    if "against_instruction" in scores and "approved_plan_step" in values:
        # Approving a plan lifts earlier "plan only" limits for the plan's own steps; conditions on the approval still hold.
        scores["against_instruction"] = min(scores["against_instruction"], 1 - values["approved_plan_step"])
    if "beyond_request" in values and "serves_request" in values:
        # Extra work denies only when the call does not also do what was asked: alone, beyond_request
        # denied too many real calls that did the requested work plus a small step around it.
        scores["beyond_request"] = min(values["beyond_request"], 1 - values["serves_request"], change)
    if {"extra_behavior", "beyond_request", "bounded_request"} <= values.keys():
        # Extra work inside a call that also does what was asked: only clear when the request is small and specific
        # and both questions agree. Open-ended jobs and side remarks made it deny too much real work.
        scores["extra_behavior"] = min(values["extra_behavior"], values["beyond_request"], values["bounded_request"], change)
    if "request_is_question" in values:
        # Delivering a requested review or plan as a new document is answering, not changing.
        # A review request is a question too; its own narrow question keeps "however thorough" reviews from reading as work orders.
        asked = max(values["request_is_question"], values.get("asks_for_review", 0.0))
        scores[QUESTION_ONLY] = min(asked, change, 1 - values.get("writes_up_answer", 0.0))
    if "serves_request" in values and "finishes_earlier" in values:
        # A request that is only a question names no task to stray from; question_only covers it.
        not_question = 1 - values.get("request_is_question", 0.0)
        scores[OTHER_TASK] = min(1 - values["serves_request"], 1 - values["finishes_earlier"], not_question, change)
    return scores


