}
READ_ONLY_GIT = {"status", "diff", "log", "show", "rev-parse", "ls-files", "blame", "describe", "shortlog", "grep", "cat-file", "ls-tree", "merge-base"}
_REDIRECT_NOISE_RE = re.compile(r"\d?>&\d|&?\d?>\s*/dev/null")
_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def _piece_is_read_only(words: list[str]) -> bool:
    while words and _ASSIGNMENT_RE.match(words[0]):
        words = words[1:]
    if not words:
        return True
    program, args = os.path.basename(words[0]), words[1:]
    if program not in READ_ONLY_PROGRAMS:
        return False
    if program == "find":
        return not any(a in ("-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprintf", "-fls") for a in args)
    if program == "sed":
        return not any(a.startswith("-i") or a.startswith("--in-place") for a in args)
    if program == "sort":
        return not any(a.startswith("-o") or a.startswith("--output") for a in args)
    if program == "awk":
        return not any("system(" in a or ">" in a for a in args)
    if program == "git":
        flags = [a for a in args if a.startswith("-")]
        rest = [a for a in args if not a.startswith("-")]
        if not rest:
            return bool(flags)  # git --version
        sub, subargs = rest[0], rest[1:]
        if sub in READ_ONLY_GIT:
            return True
        if sub == "branch":
            return not subargs and not any(f in ("-d", "-D", "-m", "-M", "-c", "-C", "--delete", "--move", "--copy") for f in flags)
        if sub in ("remote", "tag", "stash", "reflog"):
            return not subargs or subargs[0] in ("list", "show", "-v")
        if sub == "config":
            return any(f in ("--get", "--list", "-l", "--get-all") for f in flags)
        return False
    return True


def shell_is_read_only(command: str) -> bool:
    """True when every piece of the command only reads. Anything unsure is False, so it gets checked."""
    if not command.strip():
        return True
    if "$(" in command or "`" in command or "<(" in command:
        return False
    if ">" in _REDIRECT_NOISE_RE.sub("", command):
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return False
    pieces, current = [], []
    for token in tokens:
        if token and set(token) <= set(";&|"):
            pieces.append(current)
            current = []
        else:
            current.append(token)
    pieces.append(current)
    return all(_piece_is_read_only(p) for p in pieces)


def shell_command(tool_input) -> str:
    if isinstance(tool_input, dict):
        value = tool_input.get("command", tool_input.get("cmd", ""))
    else:
        value = tool_input
    if isinstance(value, list):
        words = [str(w) for w in value]
        # ["bash", "-lc", "..."]: the script is the last word.
        if len(words) >= 3 and os.path.basename(words[0]) in ("bash", "sh", "zsh") and words[1] in ("-c", "-lc"):
            return words[-1]
        return shlex.join(words)
    return str(value or "")


def needs_check(tool: str, tool_input) -> bool:
    name = (tool or "").lower()
    if name in SHELL_TOOLS:
        return not widened_read_only(shell_command(tool_input))  # W1
    return name in EDIT_TOOLS or name in AGENT_TOOLS


