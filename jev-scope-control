# Jev

_LOCAL_HOSTS = ("localhost", "127.0.0.1", "::1")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow redirects: urllib would resend the Authorization header to wherever they point."""

    def redirect_request(self, *args, **kwargs):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def jev_url() -> str:
    """The Jev endpoint. The API key is sent to it, so only https is allowed, except to this machine."""
    base_url = (os.environ.get("TYPESAFE_BASE_URL", "").strip() or DEFAULT_BASE_URL).rstrip("/")
    parts = urllib.parse.urlsplit(base_url)
    if parts.scheme != "https" and not (parts.scheme == "http" and parts.hostname in _LOCAL_HOSTS):
        raise ValueError(f"TYPESAFE_BASE_URL must be an https URL, got {base_url!r}")
    return base_url + SYSTEM_ONE_PATH


def ask_jev(state: dict, questions: dict, api_key: str, timeout: float = JEV_TIMEOUT_SECONDS) -> dict:
    """POST to Jev in a daemon thread, abandoned after `timeout` seconds in total."""
    outcome: dict = {}

    def call():
        try:
            body = json.dumps({"state": state, "model": JEV_MODEL, "questions": questions}).encode()
            request = urllib.request.Request(jev_url(), data=body, method="POST", headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": "jev-scope-control",
            })
            with _OPENER.open(request, timeout=timeout) as response:
                outcome["response"] = json.loads(response.read())
        except urllib.error.HTTPError as error:
            outcome["error"] = ValueError(f"HTTP {error.code}: {error.read()[:300].decode(errors='replace')}")
        except BaseException as error:
            outcome["error"] = error

    worker = threading.Thread(target=call, daemon=True)
    worker.start()
    worker.join(timeout)
    if worker.is_alive():
        raise TimeoutError(f"no answer within {timeout:g} seconds")
    if "error" in outcome:
        raise outcome["error"]
    return outcome["response"]


def judge(state: dict, api_key: str, bar: float, ask=None) -> tuple[dict, dict, dict]:
    """Ask Jev about one call, once; returns (response, answers, decision scores)."""
    response = (ask or ask_jev)(state, QUESTIONS, api_key)
    values = noul_values(response)
    return response, values, compose(values)


def noul_values(response: dict) -> dict[str, float]:
    answers = response.get("answers")
    if not isinstance(answers, dict):
        raise ValueError("Jev response has no answers")
    return {q: float(a["noul"]) for q, a in answers.items() if isinstance(a, dict) and isinstance(a.get("noul"), (int, float))}


# ---------------------------------------------------------------------------
# Main


def short_call(tool: str, tool_input) -> str:
    if (tool or "").lower() in SHELL_TOOLS:
        return f"{tool}: {one_line(shell_command(tool_input), 80)}"
    if isinstance(tool_input, dict):
        file = tool_input.get("file_path") or tool_input.get("filePath") or tool_input.get("path") or tool_input.get("notebook_path")
        if file:
            return f"{tool}: {file}"
    return one_line(f"{tool}: {stringify(tool_input)}", 100)


DO_NOT_WORK_AROUND = (
    "In your reply, tell the user plainly what you were trying to do with this call and why, and that "
    "jev-scope-control blocked it for the reasons above. Do not retry it or work around it. If you believe the step "
    "is needed, ask the user; otherwise continue with what was asked."
)


def denial_reason(tool: str, flagged: list[str], repeat: bool = False) -> str:
    """The message the model gets: what was flagged, and that it must tell the user what it tried."""
    head = f"this {tool} call was already denied for this request" if repeat else f"this {tool} call looks outside what the user asked for or agreed to"
    return "\n".join([f"{MARKER} Denied: {head}."] + [f"- {FEEDBACK[name]}" for name in flagged if name in FEEDBACK] + [DO_NOT_WORK_AROUND])


def deny(reason: str, user_message: str) -> dict:
    return {
        "hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason},
        "systemMessage": user_message,
    }


def warn_once(session: dict, session_id: str, kind: str, message: str) -> dict | None:
    """A systemMessage for the first failure of this kind in the session; later ones are only logged."""
    warned = session.setdefault("warned", [])
    if kind in warned:
        return None
    warned.append(kind)
    save_session(session_id, session)
    return {"systemMessage": f"jev-scope-control did not check this call: {message}. Details: ~/.jev-scope-control/log.jsonl"}


def run(hook_input: dict) -> dict | None:
    """Check one tool call. Return the hook output to print, or None to let the call run."""
    tool = str(hook_input.get("tool_name") or "")
    tool_input = hook_input.get("tool_input")
    if not needs_check(tool, tool_input):
        return None
    session_id = str(hook_input.get("session_id") or "unknown")
    host = hook_input.get("host") if isinstance(hook_input.get("host"), str) else None
    harness = host or ("codex" if "turn_id" in hook_input else "claude")
    base = {"session_id": session_id, "harness": harness, "tool": tool, "call": short_call(tool, tool_input)}
    if hook_input.get("agent_id"):
        base["agent_id"] = hook_input["agent_id"]
    session = load_session(session_id)

    key = api_key()
    if not key:
        error = "TYPESAFE_API_KEY is not set in this environment or in " + " or ".join(map(str, key_files()))
        log({**base, "error": error})
        return warn_once(session, session_id, "no-key", error)

    task, actions, earlier, conversation, found, assignment = context(hook_input, harness)
    if not found:
        base["call_not_in_transcript"] = True
    if hook_input.get("agent_id") and harness == "claude" and not assignment:
        base["subagent_assignment_missing"] = True  # judged with the main agent's context only
    if not task:
        log({**base, "skipped": "no user request found"})
        return None

    # A denied call stays denied until the user's request changes: the same call again, however often, is denied
    # without asking Jev. The denied calls are kept for the current request only.
    task_key = hashlib.sha256(task.encode()).hexdigest()[:16]
    call_key = hashlib.sha256(f"{tool}\0{json.dumps(tool_input, sort_keys=True)}".encode()).hexdigest()[:16]
    if session.get("denied_for") != task_key:
        session["denied_for"], session["denied_calls"], session["denied_flags"] = task_key, [], {}
    denied_calls = list(session["denied_calls"])
    if call_key in denied_calls:
        earlier_flags = session.get("denied_flags", {}).get(call_key, [])
        log({**base, "denied": True, "repeat": True, "flagged": earlier_flags, "task": one_line(task, 300)})
        return deny(
            denial_reason(tool, earlier_flags, repeat=True),
            f"jev-scope-control denied {short_call(tool, tool_input)} again ({', '.join(SHORT[n] for n in earlier_flags if n in SHORT) or 'already denied for this request'})",
        )

    # R1: the same call in the same context was decided moments ago (or is being decided by a second hook).
    rkey = cache_key(session_id, hook_input.get("agent_id"), task, tool, tool_input, actions)
    cached = cache_get(rkey)
    if cached is not None:
        log({**base, "cached": True, "denied": cached["denied"], "flagged": cached.get("flagged", []), "task": one_line(task, 300)})
        if not cached["denied"]:
            return None
        flagged = cached.get("flagged", [])
        return deny(denial_reason(tool, flagged),
                    f"jev-scope-control denied {short_call(tool, tool_input)} ({', '.join(SHORT[n] for n in flagged if n in SHORT)})")
    try:
        started = time.monotonic()
        result = decide(tool, tool_input, task, actions, earlier, conversation, assignment, key)
    except (urllib.error.URLError, OSError, ValueError, TypeError) as error:
        cache_release(rkey)
        message = f"Jev call failed: {type(error).__name__}: {error}"
        log({**base, "error": message})
        return warn_once(session, session_id, "jev-error", message)
    flagged = result.get("flagged", [])
    scores = result.get("scores", {})
    cache_put(rkey, bool(flagged), flagged)
    entry = {
        **base, "stage": result["stage"], "seconds": round(time.monotonic() - started, 2),
        "requests": result["requests"],
        **{k: result[k] for k in ("writes", "write_skipped", "gate_risk", "gate_probs", "error", "gate_error", "jev_model", "dropped_actions") if k in result},
        "answers": result.get("values"), "scores": scores, "threshold": threshold(),
        "denied": bool(flagged), "flagged": flagged, "task": one_line(task, 300),
    }
    if not flagged:
        log(entry)
        save_session(session_id, session)
        return None
    session["denied_calls"] = [*denied_calls, call_key]
    session["denied_flags"] = {**session.get("denied_flags", {}), call_key: flagged}
    save_session(session_id, session)
    log(entry)
    reason = denial_reason(tool, flagged)
    user_message = f"jev-scope-control denied {short_call(tool, tool_input)} ({', '.join(SHORT[n] for n in flagged)})"
    return deny(reason, user_message)


def main() -> int:
    try:
        hook_input = json.loads(sys.stdin.read() or "{}")
        if not isinstance(hook_input, dict):
            raise ValueError("hook input is not a JSON object")
        output = run(hook_input)
    except Exception as error:  # fail open: never trap the assistant
        log({"error": f"unexpected: {type(error).__name__}: {error}"})
        output = None
    if output is not None:
        sys.stdout.write(json.dumps(output))
    return 0


if __name__ == "__main__":
    sys.exit(main())
