def compose(values: dict[str, float]) -> dict[str, float]:
    """Each denying component's decision score. The ANDs are mins."""
    scores = {name: values[name] for name in DIRECT if name in values}
    if "beyond_request" in values and "serves_request" in values:
        # Extra work denies only when the call does not also do what was asked: alone, beyond_request
        # denied too many real calls that did the requested work plus a small step around it.
        # Extra work is excused by the latest request or by unfinished earlier work it continues.
        served = max(values["serves_request"], values.get("finishes_earlier", 0.0))
        scores["beyond_request"] = min(values["beyond_request"], 1 - served)
    if "serves_request" in values and "finishes_earlier" in values:
        # Work that neither the latest request nor an unfinished earlier one asks for is another task.
        scores[OTHER_TASK] = min(1 - values["serves_request"], 1 - values["finishes_earlier"])
    if {"extra_behavior", "beyond_request"} <= values.keys():
        # Extra work inside a call that also does what was asked: only when both questions agree.
        scores["extra_behavior"] = min(values["extra_behavior"], values["beyond_request"])
    return scores


