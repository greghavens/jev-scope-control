# ---------------------------------------------------------------------------
# To keep Jev requests few and small: a wider read-only rule, plain writes skip the read/write question, one gate
# question on a small state before the full check, and a short cache of verdicts for repeated calls.

# W1: the read-only rule, widened. Pieces are split on newlines too (the rule above does not: "ls\nrm -rf x"
# counts as read-only there), `cat <<EOF` bodies are dropped, `$(...)` is allowed when what it runs only reads,
# shell loop and branch keywords are skipped, and `kill -0` reads.
_SEPARATORS = set(";&|\n")
_HEREDOC_RE = re.compile(r"(?<!<)<<(?!<)(-?)\s*(['\"]?)([A-Za-z_][\w.-]*)\2")
_SUBST_RE = re.compile(r"\$\(([^()]*)\)")
_KEYWORDS_DROP = {"do", "then", "else", "elif", "if", "while", "until", "!", "{", "}"}
_KEYWORDS_END = {"done", "fi"}


def split_heredocs(command: str) -> tuple[str, list[tuple[str, bool, str]]] | None:
    """(command without heredoc bodies, [(header line, quoted tag, body)]), or None when a body has no end line."""
    lines = command.split("\n")
    out, bodies, i = [], [], 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        for match in _HEREDOC_RE.finditer(line):
            tag, quoted = match.group(3), bool(match.group(2))
            body = []
            while i < len(lines) and lines[i].strip() != tag:
                body.append(lines[i])
                i += 1
            if i >= len(lines):
                return None
            i += 1
            bodies.append((line[: match.start()], quoted, "\n".join(body)))
    return "\n".join(out), bodies


def _pieces(command: str, punctuation: str = ";&|\n") -> list[list[str]] | None:
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=punctuation)
        lexer.whitespace_split = True
        lexer.whitespace = " \t\r"
        tokens = list(lexer)
    except ValueError:
        return None
    pieces, current = [], []
    for token in tokens:
        if token and set(token) <= _SEPARATORS:
            pieces.append(current)
            current = []
        else:
            current.append(token)
    pieces.append(current)
    return pieces


def _without_keywords(words: list[str]) -> list[str] | None:
    """The command a piece runs once shell keywords are skipped; [] for a piece that runs nothing, None when unsure."""
    while words and words[0] in _KEYWORDS_DROP:
        words = words[1:]
    if not words or words[0] in _KEYWORDS_END:
        return [] if len(words) <= 1 else None
    if words[0] == "for":
        return [] if len(words) >= 3 and words[2] == "in" else None
    if words[0] in ("case", "select", "function"):
        return None
    return words


def _read_only_words(words: list[str]) -> bool:
    words = _without_keywords(list(words))
    if words is None:
        return False
    if not words:
        return True
    rest = words
    while rest and _ASSIGNMENT_RE.match(rest[0]):
        rest = rest[1:]
    if rest and os.path.basename(rest[0]) == "kill" and len(rest) >= 2 and rest[1] == "-0":
        return True
    return _piece_is_read_only(words)


def _substitutions_read_only(text: str) -> str | None:
    """`text` with each read-only `$(...)` replaced by a plain word, or None if one may write."""
    while True:
        match = _SUBST_RE.search(text)
        if not match:
            break
        if not widened_read_only(match.group(1)):
            return None
        text = text[: match.start()] + "SUBST" + text[match.end():]
    if "$(" in text or "`" in text or "<(" in text or ">(" in text:
        return None
    return text


def widened_read_only(command: str) -> bool:
    """True when every piece of the command only reads (W1). Anything unsure is False."""
    if not command.strip():
        return True
    split = split_heredocs(command)
    if split is None:
        return False
    stripped, bodies = split
    for header, quoted, body in bodies:
        # Only `cat <<EOF` bodies are dropped: another program reading a script from stdin (awk, sed) is not a plain read.
        last = (_pieces(header) or [[]])[-1]
        last = _without_keywords(last) or []
        if not last or os.path.basename(last[0]) != "cat":
            return False
        if not quoted and _substitutions_read_only(body) is None:
            return False  # an unquoted heredoc runs the $(...) in its body
    stripped = _substitutions_read_only(stripped)
    if stripped is None:
        return False
    stripped = _REDIRECT_NOISE_RE.sub("", stripped)
    if ">" in stripped:
        return False
    pieces = _pieces(stripped)
    return pieces is not None and all(_read_only_words([w for w in p if not w.startswith("<<")]) for p in pieces)


# W2: commands that plainly write skip the read/write question and go straight to the gate.
