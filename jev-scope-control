# ---------------------------------------------------------------------------
# To keep Jev requests few and small: a wider read-only rule, plain writes skip the read/write question, one gate
# question on a small state before the full check, and a short cache of verdicts for repeated calls.

# W1: the read-only rule, widened. Pieces are split on newlines too (the rule above does not: "ls\nrm -rf x"
# counts as read-only there), `cat <<EOF` bodies are dropped, `$(...)` is allowed when what it runs only reads,
# shell loop and branch keywords are skipped, and `kill -0` reads.
_SEPARATORS = set(";&|\n")
_HEREDOC_RE = re.compile(r"(?<!<)<<(?!<)(-?)\s*(['\"]?)([A-Za-z_][\w.-]*)\2")
_SUBST_RE = re.compile(r"\$\(([^()]*)\)")
_KEYWORDS_DROP = {"do", "then", "else", "elif", "if", "while", "until", "!", "{", "}"}
_KEYWORDS_END = {"done", "fi"}


def split_heredocs(command: str) -> tuple[str, list[tuple[str, bool, str]]] | None:
    """(command without heredoc bodies, [(header line, quoted tag, body)]), or None when a body has no end line."""
    lines = command.split("\n")
    out, bodies, i = [], [], 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        for match in _HEREDOC_RE.finditer(line):
            tag, quoted = match.group(3), bool(match.group(2))
            body = []
            while i < len(lines) and lines[i].strip() != tag:
                body.append(lines[i])
                i += 1
            if i >= len(lines):
                return None
            i += 1
            bodies.append((line[: match.start()], quoted, "\n".join(body)))
    return "\n".join(out), bodies


def strip_comments(command: str) -> str | None:
    """The command without comments, as bash reads them: `#` at the start of a word outside quotes, up to the end of
    the line. shlex instead starts a comment at any `#` (`${x#y}`) and swallows the newline after it, which hid the
    commands that followed. None when the quoting is unsure."""
    out, quote, i = [], None, 0
    while i < len(command):
        ch = command[i]
        if quote:
            if ch == "\\" and quote == '"' and i + 1 < len(command):
                out.append(command[i:i + 2])
                i += 2
                continue
            if ch == quote:
                quote = None
        elif ch == "\\" and i + 1 < len(command):
            out.append(command[i:i + 2])
            i += 2
            continue
        elif ch == "$" and command[i + 1:i + 2] == "'":
            return None  # $'...' takes backslash escapes this scan doesn't follow
        elif ch in "'\"":
            quote = ch
        elif ch == "#" and (i == 0 or command[i - 1] in " \t\n;&|()<>"):
            while i < len(command) and command[i] != "\n":
                i += 1
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def _pieces(command: str, punctuation: str = ";&|\n", separators: bool = False) -> list | None:
    """The command's words, split into pieces at `punctuation`. With `separators`, (separator before, words) pairs."""
    command = strip_comments(command)
    if command is None:
        return None
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=punctuation)
        lexer.whitespace_split = True
        lexer.whitespace = " \t\r"
        lexer.commenters = ""
        tokens = list(lexer)
    except ValueError:
        return None
    pieces, current, before, separator = [], [], [], ""
    for token in tokens:
        if token and set(token) <= _SEPARATORS:
            pieces.append(current)
            before.append(separator)
            current, separator = [], token
        else:
            current.append(token)
    pieces.append(current)
    before.append(separator)
    return list(zip(before, pieces)) if separators else pieces


def _without_keywords(words: list[str]) -> list[str] | None:
    """The command a piece runs once shell keywords are skipped; [] for a piece that runs nothing, None when unsure."""
    while words and words[0] in _KEYWORDS_DROP:
        words = words[1:]
    if not words or words[0] in _KEYWORDS_END:
        return [] if len(words) <= 1 else None
    if words[0] == "for":
        return [] if len(words) >= 3 and words[2] == "in" else None
    if words[0] in ("case", "select", "function"):
        return None
    return words


