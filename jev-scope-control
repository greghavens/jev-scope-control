_REDIRECT_NOISE_RE = re.compile(r"\d?>&\d|&?\d?>\s*/dev/null")
_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def _awk_pipes(script: str) -> bool:
    """True when an awk script pipes to or from a command (`print | "sh"`, `"cmd" | getline`). A `|` inside a
    string, a /regex/ or `||` is not a pipe, and neither is `-F|`."""
    if script.startswith("-F"):
        return False
    script = re.sub(r'"(\\.|[^"\\])*"', '""', script)
    script = re.sub(r"/(\\.|[^/\\\n])+/", "//", script)
    return "|" in script.replace("||", "")


def _short_flags(args: list[str]) -> str:
    """The letters of every single-dash flag (`-ni` gives "ni")."""
    return "".join(a[1:] for a in args if a.startswith("-") and not a.startswith("--"))


def _operands(args: list[str], takes_value: tuple[str, ...] = ()) -> list[str]:
    """The arguments that are not flags or flag values."""
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a.startswith("-") and a != "-":
            skip = a in takes_value
        else:
            out.append(a)
    return out


# Flags that make an otherwise read-only program write a file or run another program.
_WRITING_FLAGS = {
    "find": ("-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprint0", "-fprintf", "-fls"),
    "sort": ("-o", "--output", "--compress-program"),
    "less": ("-o", "-O", "--log-file", "--LOG-FILE"),
    "file": ("-C", "--compile"),
    "tree": ("-o",),
    "rg": ("--pre",),
    "ag": ("--pager",),
    "fd": ("-x", "-X", "--exec", "--exec-batch"),
    "date": ("-s", "--set"),
    "hostname": ("-F", "--file", "-b", "--boot"),
    "yq": ("-i", "--inplace", "-s", "--split-exp"),
}


def _piece_is_read_only(words: list[str]) -> bool:
    while words and _ASSIGNMENT_RE.match(words[0]):
        words = words[1:]
    if not words:
        return True
    program, args = os.path.basename(words[0]), words[1:]
    if program not in READ_ONLY_PROGRAMS:
        return False
    if any(a.startswith(f) for f in _WRITING_FLAGS.get(program, ()) for a in args):
        return False
    if program == "sed":
        # -i edits in place and -f runs commands from a file, also inside `-ni`; the `w` and `e` commands write a
        # file or run a command
        return not (set(_short_flags(args)) & set("if") or any(a.startswith(("--in-place", "--file")) for a in args)
                    or any(re.search(r"(?<![A-Za-z])[wWe](\s|$)", a) for a in args))
    if program == "awk":
        # -f runs a program file, -l loads an extension and gawk's -i inplace edits files; -F and -v take values
        if any(a.startswith(("-f", "-i", "-E", "-l", "--file", "--include", "--exec", "--load")) for a in args):
            return False
        scripts = [a for i, a in enumerate(args) if not (i and args[i - 1] in ("-F", "-v"))]
        return not any("system(" in a or ">" in a or "@include" in a or "@load" in a or _awk_pipes(a) for a in scripts)
    if program == "uniq":
        return len(_operands(args, ("-f", "-s", "-w"))) <= 1  # `uniq in out` writes out
    if program == "xxd":
        return not set(_short_flags(args)) & {"r"} and "-revert" not in args \
            and len(_operands(args, ("-c", "-g", "-l", "-s", "-o", "-n", "-C"))) <= 1
    if program == "hostname":
        return not _operands(args)  # `hostname NAME` sets it
    if program == "git":
        return _git_reads(args)
    return True


_GIT_GLOBAL_FLAGS = ("--no-pager", "-P", "--no-optional-locks", "--literal-pathspecs", "--glob-pathspecs",
                     "--noglob-pathspecs", "--icase-pathspecs", "--no-replace-objects", "--version", "--help",
                     "--git-dir=", "--work-tree=", "--bare")


def _git_reads(args: list[str]) -> bool:
    while args and args[0].startswith("-"):
        if not args[0].startswith(_GIT_GLOBAL_FLAGS):
            return False  # -c and --config-env set config, --exec-path picks the programs git runs
        args = args[1:]
    if not args:
        return True  # git --version
    sub, rest = args[0], args[1:]
    flags = [a for a in rest if a.startswith("-")]
    subargs = [a for a in rest if not a.startswith("-")]
    # --output writes a file; -O and --open-files-in-pager run a command; --ext-diff runs the configured diff program
    if any(f.startswith(("--output", "-O", "--open-files-in-pager", "--ext-diff")) for f in flags):
        return False
    if sub in READ_ONLY_GIT:
        return True
    if sub == "branch":
        return not subargs and not any(f.startswith(("-d", "-D", "-m", "-M", "-c", "-C", "--delete", "--move", "--copy",
                                                     "--set-upstream", "--unset-upstream", "--edit-description"))
                                       for f in flags)
    if sub == "stash":
        return subargs[:1] in (["list"], ["show"])  # bare `git stash` stashes the changes
    if sub in ("remote", "tag", "reflog"):
        return not subargs or subargs[0] in ("list", "show", "-v")
    if sub == "config":
        return any(f in ("--get", "--list", "-l", "--get-all") for f in flags) and not any(
            f.startswith(("--add", "--unset", "--replace", "--rename", "--remove", "-e", "--edit")) for f in flags)
    return False


def shell_is_read_only(command: str) -> bool:
    """True when every piece of the command only reads. Anything unsure is False, so it gets checked."""
    if not command.strip():
        return True
    if "$(" in command or "`" in command or "<(" in command:
        return False
    if ">" in _REDIRECT_NOISE_RE.sub("", command):
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return False
    pieces, current = [], []
    for token in tokens:
        if token and set(token) <= set(";&|"):
            pieces.append(current)
            current = []
        else:
            current.append(token)
    pieces.append(current)
    return all(_piece_is_read_only(p) for p in pieces)


def shell_command(tool_input) -> str:
    if isinstance(tool_input, dict):
        value = tool_input.get("command", tool_input.get("cmd", ""))
    else:
        value = tool_input
    if isinstance(value, list):
        words = [str(w) for w in value]
        # ["bash", "-lc", "..."]: the script is the last word.
        if len(words) >= 3 and os.path.basename(words[0]) in ("bash", "sh", "zsh") and words[1] in ("-c", "-lc"):
            return words[-1]
        return shlex.join(words)
    return str(value or "")


def needs_check(tool: str, tool_input) -> bool:
    name = (tool or "").lower()
    if name in SHELL_TOOLS:
        return not widened_read_only(shell_command(tool_input))  # W1
    return name in EDIT_TOOLS or name in AGENT_TOOLS


