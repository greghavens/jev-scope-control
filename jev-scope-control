    "lsof", "free", "uptime", "cd", "find", "sed", "awk", "sort", "git",
}
READ_ONLY_GIT = {"status", "diff", "log", "show", "rev-parse", "ls-files", "blame", "describe", "shortlog", "grep", "cat-file", "ls-tree", "merge-base"}
_REDIRECT_NOISE_RE = re.compile(r"\d?>&\d|&?\d?>\s*/dev/null")
_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def _piece_is_read_only(words: list[str]) -> bool:
    while words and _ASSIGNMENT_RE.match(words[0]):
        words = words[1:]
    if not words:
        return True
    program, args = os.path.basename(words[0]), words[1:]
    if program not in READ_ONLY_PROGRAMS:
        return False
    if program == "find":
        return not any(a in ("-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprintf", "-fls") for a in args)
    if program == "sed":
        return not any(a.startswith("-i") or a.startswith("--in-place") for a in args)
    if program == "sort":
        return not any(a.startswith("-o") or a.startswith("--output") for a in args)
    if program == "awk":
        return not any("system(" in a or ">" in a for a in args)
    if program == "git":
        flags = [a for a in args if a.startswith("-")]
        rest = [a for a in args if not a.startswith("-")]
        if not rest:
            return bool(flags)  # git --version
        sub, subargs = rest[0], rest[1:]
        if sub in READ_ONLY_GIT:
            return True
        if sub == "branch":
            return not subargs and not any(f in ("-d", "-D", "-m", "-M", "-c", "-C", "--delete", "--move", "--copy") for f in flags)
        if sub in ("remote", "tag", "stash", "reflog"):
            return not subargs or subargs[0] in ("list", "show", "-v")
        if sub == "config":
            return any(f in ("--get", "--list", "-l", "--get-all") for f in flags)
        return False
    return True


def shell_is_read_only(command: str) -> bool:
    """True when every piece of the command only reads. Anything unsure is False, so it gets checked."""
    if not command.strip():
        return True
    if "$(" in command or "`" in command or "<(" in command:
        return False
    if ">" in _REDIRECT_NOISE_RE.sub("", command):
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return False
    pieces, current = [], []
    for token in tokens:
        if token and set(token) <= set(";&|"):
            pieces.append(current)
            current = []
        else:
            current.append(token)
    pieces.append(current)
    return all(_piece_is_read_only(p) for p in pieces)


def shell_command(tool_input) -> str:
    if isinstance(tool_input, dict):
        value = tool_input.get("command", tool_input.get("cmd", ""))
    else:
        value = tool_input
    if isinstance(value, list):
        words = [str(w) for w in value]
        # ["bash", "-lc", "..."]: the script is the last word.
        if len(words) >= 3 and os.path.basename(words[0]) in ("bash", "sh", "zsh") and words[1] in ("-c", "-lc"):
            return words[-1]
        return shlex.join(words)
    return str(value or "")


def needs_check(tool: str, tool_input) -> bool:
    name = (tool or "").lower()
    if name in SKIPPED_TOOLS:
        return False
    if name in SHELL_TOOLS:
        return not shell_is_read_only(shell_command(tool_input))
    return True  # edits, writes, patches, MCP and unknown tools


# ---------------------------------------------------------------------------
# Paths, settings and logging


def home_dir() -> Path:
    return Path.home() / ".jev-scope-control"


def private_dir(sub: str = "") -> Path:
    """Create ~/.jev-scope-control[/sub] owner-only: the log and state hold the user's requests."""
    path = home_dir()
    path.mkdir(mode=0o700, exist_ok=True)
    if sub:
        path = path / sub
        path.mkdir(mode=0o700, exist_ok=True)
    return path


def log(entry: dict) -> None:
    try:
        path = private_dir() / "log.jsonl"
        record = {"time": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"), **entry}
        with path.open("a") as f:
            f.write(json.dumps(record) + "\n")
    except OSError as error:
        print(f"jev-scope-control: cannot write log ({error}): {json.dumps(entry)}", file=sys.stderr)


def session_path(session_id: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", session_id or "unknown")
    return home_dir() / "state" / f"{safe}.json"


def load_session(session_id: str) -> dict:
    try:
        raw = json.loads(session_path(session_id).read_text())
        return raw if isinstance(raw, dict) else {}
    except (OSError, ValueError):
        return {}


def save_session(session_id: str, data: dict) -> None:
    try:
        private_dir("state")
        path = session_path(session_id)
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(data))
        os.replace(tmp, path)
    except OSError:
        pass


def key_files() -> list[Path]:
    config = Path(os.environ.get("XDG_CONFIG_HOME", "").strip() or str(Path.home() / ".config"))
    return [config / "jev-scope-control" / "env", config / "jev-no-bullshit" / "env"]


def api_key() -> str:
    """TYPESAFE_API_KEY from the environment, else from the first key file that sets it."""
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if key:
        return key
    for path in key_files():
        try:
            lines = path.read_text().splitlines()
        except OSError:
            continue
        for line in lines:
            match = re.match(r"\s*(?:export\s+)?TYPESAFE_API_KEY\s*=\s*(.*)$", line)
            if match:
                key = match.group(1).strip()
                if len(key) >= 2 and key[0] == key[-1] and key[0] in "'\"":
                    key = key[1:-1].strip()
                if key:
                    return key
    return ""


def number_setting(name: str, default: float, minimum: float, maximum: float, integer: bool = False) -> float:
    try:
        value = float(os.environ.get(name, ""))
    except ValueError:
        return default
    if not (minimum <= value <= maximum) or (integer and not value.is_integer()):
        return default
    return int(value) if integer else value


def threshold() -> float:
    return number_setting("JEV_SCOPE_CONTROL_THRESHOLD", DEFAULT_THRESHOLD, 0.0, 1.0)


def max_denials() -> int:
    return int(number_setting("JEV_SCOPE_CONTROL_MAX_DENIALS", DEFAULT_MAX_DENIALS, 1, 1_000_000, integer=True))


# ---------------------------------------------------------------------------
# Text helpers


def clip(text: str, limit: int) -> str:
    """Keep the head and tail of a long text."""
    if len(text) <= limit:
        return text
    half = (limit - 30) // 2
    return f"{text[:half]}\n[... {len(text) - 2 * half} characters cut ...]\n{text[-half:]}"


def one_line(text: str, limit: int) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def stringify(value) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    return json.dumps(value, ensure_ascii=False)


def content_text(content) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, str):
                parts.append(block)
            elif isinstance(block, dict):
                if isinstance(block.get("text"), str):
                    parts.append(block["text"])
                elif block.get("type") in ("image", "input_image"):
                    parts.append("[image]")
        return "\n".join(parts)
    return stringify(content)


# Wrappers Claude Code and Codex put around text that the user did not type.
_NOT_TYPED_PREFIXES = (
    "<command-name>", "<command-message>", "<command-args>", "<local-command-", "<task-notification>",
    "<system-reminder>", "<user-prompt-submit-hook>", "<hook_prompt", "<environment_context>",
    "<user_instructions>", "<user_shell_command>", "<turn_aborted>", "<permissions", "<INSTRUCTIONS>",
    "# AGENTS.md instructions", "[Request interrupted", "Stop hook feedback:", "[jev-no-bullshit]",
    "The jev-no-bullshit plugin sent a message:", "Caveat: The messages below",
)


def is_real_user_text(text: str) -> bool:
    stripped = text.strip()
    return bool(stripped) and not stripped.startswith(_NOT_TYPED_PREFIXES) and MARKER not in stripped[:300]


def action_line(tool: str, tool_input, result: str | None) -> dict:
    limit = AGENT_PROMPT_CHARS if (tool or "").lower() in ("agent", "task", "spawn_agent") else ACTION_INPUT_CHARS
    return {
        "tool": tool or "unknown",
        "input": one_line(stringify(tool_input), limit),
        "result": one_line(result, ACTION_RESULT_CHARS) if result is not None else "(not run yet)",
    }


def proposed(tool: str, tool_input) -> dict:
    """The call being judged, with its parts named so the questions can read them."""
    name = (tool or "").lower()
    part = lambda value: clip(stringify(value), PROPOSED_PART_CHARS)  # noqa: E731
    if not isinstance(tool_input, dict):
        return {"tool": tool, "input": part(tool_input)}
    if name in SHELL_TOOLS:
        shown = {"command": part(shell_command(tool_input))}
        if tool_input.get("description"):
            shown["description"] = part(tool_input["description"])
        return {"tool": tool, "input": shown}
    file = tool_input.get("file_path") or tool_input.get("filePath") or tool_input.get("path") or tool_input.get("notebook_path")
    if "old_string" in tool_input or "oldString" in tool_input:
        return {"tool": tool, "input": {
            "file": file,
            "replace": part(tool_input.get("old_string", tool_input.get("oldString"))),
            "with": part(tool_input.get("new_string", tool_input.get("newString"))),
        }}
    if isinstance(tool_input.get("edits"), list):  # MultiEdit, pi's edit
        return {"tool": tool, "input": {"file": file, "edits": [
            {"replace": part(e.get("old_string", e.get("oldText"))), "with": part(e.get("new_string", e.get("newText")))}
            for e in tool_input["edits"][:10] if isinstance(e, dict)
        ]}}
    if "content" in tool_input and file:
        return {"tool": tool, "input": {"file": file, "content": part(tool_input["content"])}}
    if name == "apply_patch" or "patchText" in tool_input:
        return {"tool": tool, "input": {"patch": part(tool_input.get("command", tool_input.get("patchText", tool_input.get("input"))))}}
    return {"tool": tool, "input": {k: part(v) for k, v in tool_input.items()}}


# ---------------------------------------------------------------------------
# Transcripts


def wait_for_call(path: str | None, call_id: str | None, timeout: float = CALL_WAIT_SECONDS) -> bool:
    """Wait until the transcript holds the call being checked. The harness writes its transcript after
    it runs the hook, so without this a turn's first call is read with the user's message missing, or
    with the previous request taken for the current one. Writes are in order: once the call is there,
    so is everything before it."""
    if not path or not call_id:
        return False
    deadline = time.monotonic() + timeout
    while True:
        try:
            if call_id in Path(path).read_text(errors="replace"):
                return True
        except OSError:
            pass
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.02)


def read_jsonl(path: str | None) -> list[dict]:
    if not path:
        return []
    entries = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict):
                    entries.append(obj)
    except OSError:
        return []
    return entries


def parse_claude(entries: list[dict], current_call: str | None) -> tuple[str, list[dict], list[dict]]:
    """Return (request, conversation before it, actions since it) from a Claude Code transcript.

    Messages and tool calls are ordered by timestamp and counted once: a plugin may append a trimmed
    copy of the conversation (fast-jev-compaction does). An approved plan and an answered question are
    part of what the user agreed to, so they join the conversation as the user's words.
    """
    items: dict[tuple, dict] = {}  # (timestamp, kind, key) -> item
    calls: dict[str, dict] = {}
    for n, e in enumerate(entries):
        if e.get("isSidechain"):
            continue
        stamp = str(e.get("timestamp") or f"~{n:08d}")
        message = e.get("message") or {}
        content = message.get("content")
        if e.get("isCompactSummary"):
            text = content_text(content).strip()
            if text:
                items.setdefault((stamp, "summary", text), {"role": "summary", "text": text, "time": stamp})
            continue
        attachment = e.get("attachment") if e.get("type") == "attachment" else None
        if isinstance(attachment, dict) and attachment.get("type") == "queued_command":
            # A message the user typed while the assistant was working.
            text = content_text(attachment.get("prompt")).strip()
            if (attachment.get("origin") or {}).get("kind") == "human" and is_real_user_text(text):
                items.setdefault((stamp, "user", text), {"role": "user", "text": text, "time": stamp, "typed": True})
            continue
        if e.get("type") == "assistant" and isinstance(content, list):
            text = "\n".join(b["text"] for b in content if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str)).strip()
            if text:
                items.setdefault((stamp, "assistant", text), {"role": "assistant", "text": text, "time": stamp})
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("id") and b["id"] not in calls:
                    calls[b["id"]] = {"tool": b.get("name"), "input": b.get("input"), "result": None, "error": False, "time": stamp}
        elif e.get("type") == "user":
            if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
                for b in content:
                    if isinstance(b, dict) and b.get("type") == "tool_result":
                        call = calls.get(b.get("tool_use_id"))
                        if call is not None and call["result"] is None:
                            call["result"] = content_text(b.get("content"))
                            call["error"] = bool(b.get("is_error"))
                            call["result_time"] = stamp
                continue
            text = content_text(content).strip()
            if e.get("isMeta") or not is_real_user_text(text):
                continue
            items.setdefault((stamp, "user", text), {"role": "user", "text": text, "time": stamp, "typed": True})
    # Agreements recorded as tool calls.
    for call in calls.values():
        name = (call["tool"] or "").lower()
        if call["result"] is None or call["error"]:
            continue
        stamp = call.get("result_time", call["time"])
        if name == "exitplanmode":
            plan = stringify((call["input"] or {}).get("plan") if isinstance(call["input"], dict) else call["input"])
            items[(call["time"], "assistant", plan)] = {"role": "assistant", "text": f"Plan:\n{plan}", "time": call["time"]}
            items[(stamp, "user", "approved")] = {"role": "user", "text": "(approved this plan)", "time": stamp, "typed": True}
        elif name == "askuserquestion":
            asked = call["input"].get("questions") if isinstance(call["input"], dict) else None
            questions = "; ".join(str(q.get("question")) for q in asked if isinstance(q, dict)) if isinstance(asked, list) else ""
            if questions:
                items[(call["time"], "assistant", questions)] = {"role": "assistant", "text": f"Asked: {questions}", "time": call["time"]}
            items[(stamp, "user", call["result"])] = {"role": "user", "text": call["result"], "time": stamp, "typed": True}
    messages = sorted(items.values(), key=lambda m: m["time"])
    request_index = max((i for i, m in enumerate(messages) if m.get("typed")), default=-1)
    request = messages[request_index]["text"] if request_index >= 0 else ""
    request_time = messages[request_index]["time"] if request_index >= 0 else ""
    conversation = [{"role": m["role"], "text": m["text"]} for m in messages[: max(request_index, 0)]]
    actions = [
        action_line(c["tool"], c["input"], c["result"])
        for cid, c in sorted(calls.items(), key=lambda kv: kv[1]["time"])
        if c["time"] > request_time and cid != current_call
    ]
    return request, conversation, actions


def _codex_items(entries: list[dict]):
    for e in entries:
        if isinstance(e.get("payload"), dict) and e.get("type") in ("response_item", "event_msg", "turn_context", "session_meta", "compacted"):
            yield e["type"], e["payload"]
        elif "type" in e:
            yield "response_item", e


def parse_codex(entries: list[dict], current_call: str | None) -> tuple[str, list[dict], list[dict]]:
    """Return (request, conversation before it, actions since it) from a Codex rollout file."""
    items = list(_codex_items(entries))
    messages: list[tuple[int, dict]] = []
    typed = [(i, p.get("message") or "") for i, (kind, p) in enumerate(items) if kind == "event_msg" and p.get("type") == "user_message"]
    for i, text in typed:
        if is_real_user_text(text):
            messages.append((i, {"role": "user", "text": text.strip(), "typed": True}))
    for i, (kind, p) in enumerate(items):
        if kind != "response_item" or p.get("type") != "message":
            continue
        text = content_text(p.get("content")).strip()
        if p.get("role") == "assistant" and text:
            messages.append((i, {"role": "assistant", "text": text}))
        elif p.get("role") == "user" and not typed and is_real_user_text(text):
            messages.append((i, {"role": "user", "text": text, "typed": True}))
    messages.sort(key=lambda m: m[0])
    request_pos = max((k for k, (_, m) in enumerate(messages) if m.get("typed")), default=-1)
    request_item = messages[request_pos][0] if request_pos >= 0 else -1
    request = messages[request_pos][1]["text"] if request_pos >= 0 else ""
    conversation = [{"role": m["role"], "text": m["text"]} for _, m in messages[: max(request_pos, 0)]]
    calls: list[dict] = []
    by_id: dict[str, dict] = {}
    for n, (kind, p) in enumerate(items):
        if kind != "response_item" or n <= request_item:
            continue
        ptype = p.get("type")
        if ptype in ("function_call", "custom_tool_call", "local_shell_call"):
            if p.get("call_id") == current_call:
                continue
            tool = p.get("name") or "local_shell"
            tool_input = p.get("arguments") if ptype == "function_call" else p.get("input") if ptype == "custom_tool_call" else (p.get("action") or {}).get("command")
            if isinstance(tool_input, str):
                try:
                    tool_input = json.loads(tool_input)
                except ValueError:
                    pass
            call = {"tool": tool, "input": tool_input, "result": None}
            calls.append(call)
            if p.get("call_id"):
                by_id[p["call_id"]] = call
        elif ptype in ("function_call_output", "custom_tool_call_output"):
            call = by_id.get(p.get("call_id"))
            if call is not None:
                output = p.get("output")
                if isinstance(output, dict):
                    output = output.get("output", output.get("content"))
                call["result"] = content_text(output)
    actions = [action_line(c["tool"], c["input"], c["result"]) for c in calls]
    return request, conversation, actions


def given_turn(hook_input: dict) -> tuple[str, list[dict], list[dict]]:
    """(request, conversation, actions) as the pi or opencode plugin sent them."""
    conversation = [
        {"role": str(m.get("role") or ""), "text": str(m.get("text") or "")}
        for m in hook_input.get("conversation") or [] if isinstance(m, dict) and str(m.get("text") or "").strip()
    ]
    conversation = [m for m in conversation if m["role"] != "user" or is_real_user_text(m["text"])]
    actions = [
        action_line(str(c.get("tool") or ""), c.get("input"), c.get("result"))
        for c in hook_input.get("actions") or [] if isinstance(c, dict)
    ]
    return str(hook_input.get("task") or "").strip(), conversation, actions


# ---------------------------------------------------------------------------
# State


def fit_conversation(conversation: list[dict]) -> list[dict]:
    """Clip each message, then drop the oldest messages until the conversation fits its budget,
    assistant messages before the user's: the user's words set the scope. The last message is kept longer
    and never dropped when it is the assistant's: the request may approve what it proposes."""
    clipped = [{**m, "text": clip(m["text"], MESSAGE_CHARS)} for m in conversation]
    if clipped and clipped[-1]["role"] == "assistant":
        clipped[-1] = {**conversation[-1], "text": clip(conversation[-1]["text"], LAST_ASSISTANT_CHARS), "keep": True}
    total = sum(len(m["text"]) for m in clipped)
    for role in ("assistant", "summary", "user"):
        for m in clipped:
            if total <= CONVERSATION_CHARS:
                break
            if m["role"] == role and not m.get("dropped") and not m.get("keep"):
                m["dropped"] = True
                total -= len(m["text"])
    return [{"role": m["role"], "text": m["text"]} for m in clipped if not m.get("dropped")]


def build_state(request: str, conversation: list[dict], actions: list[dict], tool: str, tool_input, cwd: str | None) -> dict:
    state = {
        "request": clip(request, REQUEST_CHARS),
        "conversation": fit_conversation(conversation),
        "actions_so_far": actions[-ACTIONS_LIMIT:],
        "proposed_action": proposed(tool, tool_input),
    }
    if cwd:
        state["working_directory"] = cwd
    return state


# ---------------------------------------------------------------------------
# Jev

_LOCAL_HOSTS = ("localhost", "127.0.0.1", "::1")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow redirects: urllib would resend the Authorization header to wherever they point."""

    def redirect_request(self, *args, **kwargs):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def jev_url() -> str:
    """The Jev endpoint. The API key is sent to it, so only https is allowed, except to this machine."""
    base_url = (os.environ.get("TYPESAFE_BASE_URL", "").strip() or DEFAULT_BASE_URL).rstrip("/")
    parts = urllib.parse.urlsplit(base_url)
    if parts.scheme != "https" and not (parts.scheme == "http" and parts.hostname in _LOCAL_HOSTS):
        raise ValueError(f"TYPESAFE_BASE_URL must be an https URL, got {base_url!r}")
    return base_url + SYSTEM_ONE_PATH


def with_request_turn(state: dict) -> dict:
    """Also end the conversation with the request. In a long conversation Jev otherwise let older limits
    outweigh the user's latest message, such as a "plan only" after the user approved the plan."""
    if not state.get("request"):
        return state
    return {**state, "conversation": [*state.get("conversation", []), {"role": "user", "text": state["request"]}]}


def ask_jev(state: dict, questions: dict, api_key: str, timeout: float = JEV_TIMEOUT_SECONDS) -> dict:
    """POST to Jev in a daemon thread, abandoned after `timeout` seconds in total."""
    outcome: dict = {}
    state = with_request_turn(state)

    def call():
        try:
            body = json.dumps({"state": state, "model": JEV_MODEL, "questions": questions}).encode()
            request = urllib.request.Request(jev_url(), data=body, method="POST", headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": "jev-scope-control",
            })
            with _OPENER.open(request, timeout=timeout) as response:
                outcome["response"] = json.loads(response.read())
        except urllib.error.HTTPError as error:
            outcome["error"] = ValueError(f"HTTP {error.code}: {error.read()[:300].decode(errors='replace')}")
        except BaseException as error:
            outcome["error"] = error

    worker = threading.Thread(target=call, daemon=True)
    worker.start()
    worker.join(timeout)
    if worker.is_alive():
        raise TimeoutError(f"no answer within {timeout:g} seconds")
    if "error" in outcome:
        raise outcome["error"]
    return outcome["response"]


def noul_values(response: dict) -> dict[str, float]:
    answers = response.get("answers")
    if not isinstance(answers, dict):
        raise ValueError("Jev response has no answers")
    return {q: float(a["noul"]) for q, a in answers.items() if isinstance(a, dict) and isinstance(a.get("noul"), (int, float))}


# ---------------------------------------------------------------------------
# Main


def short_call(tool: str, tool_input) -> str:
    if (tool or "").lower() in SHELL_TOOLS:
        return f"{tool}: {one_line(shell_command(tool_input), 80)}"
    if isinstance(tool_input, dict):
        file = tool_input.get("file_path") or tool_input.get("filePath") or tool_input.get("path") or tool_input.get("notebook_path")
        if file:
            return f"{tool}: {file}"
    return one_line(f"{tool}: {stringify(tool_input)}", 100)


def deny(reason: str, user_message: str) -> dict:
    return {
        "hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason},
        "systemMessage": user_message,
    }


def warn_once(session: dict, session_id: str, kind: str, message: str) -> dict | None:
    """A systemMessage for the first failure of this kind in the session; later ones are only logged."""
    warned = session.setdefault("warned", [])
    if kind in warned:
        return None
    warned.append(kind)
    save_session(session_id, session)
    return {"systemMessage": f"jev-scope-control did not check this call: {message}. Details: ~/.jev-scope-control/log.jsonl"}


def run(hook_input: dict) -> dict | None:
    """Check one tool call. Return the hook output to print, or None to let the call run."""
    tool = str(hook_input.get("tool_name") or "")
    tool_input = hook_input.get("tool_input")
    if not needs_check(tool, tool_input):
        return None
    session_id = str(hook_input.get("session_id") or "unknown")
    host = hook_input.get("host") if isinstance(hook_input.get("host"), str) else None
    harness = host or ("codex" if "turn_id" in hook_input else "claude")
    base = {"session_id": session_id, "harness": harness, "tool": tool, "call": short_call(tool, tool_input)}
    if hook_input.get("agent_id"):
        base["agent_id"] = hook_input["agent_id"]
    session = load_session(session_id)

    key = api_key()
    if not key:
        error = "TYPESAFE_API_KEY is not set in this environment or in " + " or ".join(map(str, key_files()))
        log({**base, "error": error})
        return warn_once(session, session_id, "no-key", error)

    if host:
        request, conversation, actions = given_turn(hook_input)
    else:
        parse = parse_codex if harness == "codex" else parse_claude
        path, call_id = hook_input.get("transcript_path"), hook_input.get("tool_use_id")
        if not wait_for_call(path, call_id):
            base["call_not_in_transcript"] = True
        request, conversation, actions = parse(read_jsonl(path), call_id)
    if not request:
        log({**base, "skipped": "no user request found"})
        return None

    # Denials are counted per user request, so a wrong judgment can stall the work only so far.
    request_key = hashlib.sha256(f"{len(conversation)}\0{request}".encode()).hexdigest()[:16]
    if session.get("request") != request_key:
        session = {**session, "request": request_key, "denials": 0}
    limit = max_denials()
    if session.get("denials", 0) >= limit:
        log({**base, "skipped": f"denial cap of {limit} reached for this request"})
        return None

    state = build_state(request, conversation, actions, tool, tool_input, hook_input.get("cwd"))
    try:
        started = time.monotonic()
        response = ask_jev(state, QUESTIONS, key)
        values = noul_values(response)
    except (urllib.error.URLError, OSError, ValueError, TypeError) as error:
        message = f"Jev call failed: {type(error).__name__}: {error}"
        log({**base, "error": message})
        return warn_once(session, session_id, "jev-error", message)
    scores = compose(values)
    bar = threshold()
    flagged = [name for name, score in scores.items() if score > bar]
    entry = {
        **base, "jev_model": response.get("model"), "seconds": round(time.monotonic() - started, 2),
        "usage": response.get("usage"), "answers": values, "scores": scores, "threshold": bar,
        "denied": bool(flagged), "flagged": flagged, "request": one_line(request, 300),
    }
    if not flagged:
        log(entry)
        save_session(session_id, session)
        return None
    session["denials"] = session.get("denials", 0) + 1
    save_session(session_id, session)
    entry["denials_this_request"] = session["denials"]
    log(entry)
    flagged.sort(key=lambda name: -scores[name])
    reason = "\n".join(
        [f"{MARKER} Denied: this {tool} call looks outside what the user asked for or agreed to."]
        + [f"- {FEEDBACK[name]}" for name in flagged]
        + ["Do not work around this. If you believe the step is needed, stop and ask the user; otherwise continue with what was asked."]
    )
    user_message = f"jev-scope-control denied {short_call(tool, tool_input)} ({', '.join(SHORT[n] for n in flagged)})"
    if session["denials"] >= limit:
        user_message += f"; that is {limit} denials for this request, so its remaining calls will not be checked"
    return deny(reason, user_message)


def main() -> int:
    try:
        hook_input = json.loads(sys.stdin.read() or "{}")
        if not isinstance(hook_input, dict):
            raise ValueError("hook input is not a JSON object")
        output = run(hook_input)
    except Exception as error:  # fail open: never trap the assistant
        log({"error": f"unexpected: {type(error).__name__}: {error}"})
        output = None
    if output is not None:
        sys.stdout.write(json.dumps(output))
    return 0


if __name__ == "__main__":
    sys.exit(main())
